# ── BHAT Backend Server ─ Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ── MongoDB Connection ────────────────────────────────────────────────────────
# For local development (Docker):
# MONGODB_URI=mongodb://localhost:27017/bhat-backend

# For MongoDB Atlas production:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster-name.mongodb.net/bhat-backend?appName=bhat-backend
# Get connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=3000

# ── JWT Secret (for auth routes) ─────────────────────────────────────────────
# Change this to a strong random secret in production
JWT_SECRET=bhat_secret_change_me_in_production
