# ——— BHAT TC Tracker Bot — Environment Variables ————————————————————
# Copy this file to .env and fill in your values

# Same bot token as the deadline bot (BHAT Bot#6098)
# Go to discord.com/developers/applications/1504976671634231367/bot > Reset Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Server ID
GUILD_ID=1504973606638194718

# Backend API URL
API_BASE_URL=http://localhost:3000

# Channel IDs
# CHANNEL_TC_STATUS = the channel where the TC status board lives
CHANNEL_TC_STATUS=1507827501240422542

# Channel where check-in notifications and new transaction announcements post
# Use your existing #⚡-tasks channel ID
CHANNEL_TASKS=1504991449496686724

# Owner Discord User ID (for owner-only commands: /report, /tc-stats, /screenshots, /payroll)
OWNER_ID=1135563312004857917

# Employee Management Channel IDs
CHANNEL_TC_SCREENSHOTS=1507842116582113530
CHANNEL_TC_ALERTS=1507842267937898577
CHANNEL_TC_PERFORMANCE=1507842360648794182

# Payroll Channel ID
# #💰-payroll — weekly payroll reports ($8/hour)
CHANNEL_PAYROLL=1507864576090181672

# Clock In/Out Log Channel ID
# #⏱️-clock-log — public channel, all TCs log clock in/out here
CHANNEL_CLOCK_LOG=1507867037123350588
