# ─── BHAT Deadline Bot — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values

# 1. Discord Bot Token — from discord.com/developers > BHAT Bot > Bot > Reset Token
DISCORD_BOT_TOKEN=your_bot_token_here

# 2. Your Discord Server ID — right-click your server name > Copy Server ID
GUILD_ID=1504973606638194718

# 3. Your backend API URL — localhost for dev, Heroku URL for production
API_BASE_URL=http://localhost:5000

# 4. Channel IDs — right-click each channel > Copy Channel ID
CHANNEL_DEADLINE_DASHBOARD=1506643027626688602
CHANNEL_DEADLINE_ALERTS=1506643134090706964
CHANNEL_DEADLINE_STATS=1506643222586462238
